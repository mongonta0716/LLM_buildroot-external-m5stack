#!/bin/bash
# Invoked by /etc/rc.local.d/rcS; no dedicated systemd service is needed.
[ "${1:-start}" = start ] || exit 0
[ -x /root/setup-wifi.sh ] || exit 0
[ -f /etc/wpa_supplicant.conf ] || exit 0
grep -Eq '^[[:space:]]*network[[:space:]]*=' /etc/wpa_supplicant.conf || exit 0
umask 077
nohup /root/setup-wifi.sh connect wlan0 >> /var/log/wifi-setup-wlan0.log 2>&1 < /dev/null &
exit 0
